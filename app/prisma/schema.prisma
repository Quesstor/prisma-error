generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["queryCompiler", "driverAdapters"]
  output          = "./prisma"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://app:app@postgres/app"
}

model Document {
  id   Int   @id @default(autoincrement())
  data Json?
}
